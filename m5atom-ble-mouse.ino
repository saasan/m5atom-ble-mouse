#include <M5Unified.h>
#include <HijelHID_BLEMouse.h>

// -----------------------------------------------------------------------------
// 変数
// -----------------------------------------------------------------------------
HijelBLEMouse mouse;

// -----------------------------------------------------------------------------
// 関数
// -----------------------------------------------------------------------------
void setup() {
    M5.begin();
    mouse.begin();
}

void loop() {
    M5.update();

    if (mouse.isPaired()) {
        mouse.moveTo(1, 0);
        delay(100);
        mouse.moveTo(-1, 0);

        delay(60 * 1000);
    }
    else {
        // Bluetooth未接続の場合は1秒待つ
        delay(1000);
    }
}
